---
// Marco de todas las páginas. Navegación fija con las cinco secciones: barra abajo en el celular y riel
// a la izquierda en el PC. Las páginas de un capítulo suman su índice a la derecha (slot «lateral»).
import Icono from '../components/Icono.astro';
import Ajustes from '../components/Ajustes.astro';
import { TEXTOS, fechaCorta } from '../lib/textos.mjs';
import { cssPaleta, PALETA } from '../lib/paleta.mjs';
import { REPO, SECCIONES, rutaRelativa } from '../lib/enlaces.mjs';
import { fechaChile } from '../lib/hoy.mjs';
import { jsonEnHtml } from '../lib/contenido.mjs';
import '../estilos/global.css';

const { lang, titulo, descripcion, actual, alterno, seccion = null } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const enlaceIdioma = { es: lang === 'es' ? actual : alterno, en: lang === 'en' ? actual : alterno };
const compilado = fechaChile();
const ICONO = { hoy: 'hoy', temario: 'temario', repaso: 'repaso', radar: 'radar', mas: 'mas' };
const conLateral = Astro.slots.has('lateral');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo ? `${titulo} · ${T.marca}` : T.marcaLarga}</title>
    <meta name="description" content={descripcion ?? T.descripcion} />
    <meta name="robots" content="noindex" />
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${BASE}iconos/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content={T.marca} />
    <meta name="theme-color" content={PALETA.claro.fondo} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={PALETA.oscuro.fondo} media="(prefers-color-scheme: dark)" />
    <link rel="alternate" hreflang="es" href={`${BASE}${enlaceIdioma.es}`} />
    <link rel="alternate" hreflang="en" href={`${BASE}${enlaceIdioma.en}`} />
    <style is:inline set:html={cssPaleta()}></style>
    <script is:inline>
      // Tema antes de pintar, para que no parpadee.
      try {
        var t = localStorage.getItem('escuela.tema') || 'sistema';
        var o = t === 'oscuro' || (t === 'sistema' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.tema = o ? 'oscuro' : 'claro';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">{T.saltar}</a>
    <header class="barra">
      <a class="marca" href={`${BASE}${rutaRelativa(lang, 'hoy')}`}>
        <Icono nombre="marca" clase="icono marca-icono" /><span>{T.marca}</span>
      </a>
      <Ajustes lang={lang} enlaceIdioma={enlaceIdioma} />
    </header>

    <nav class="nav-principal" aria-label={T.nav.titulo}>
      <a class="marca marca-riel" href={`${BASE}${rutaRelativa(lang, 'hoy')}`}>
        <Icono nombre="marca" clase="icono marca-icono" /><span>{T.marca}</span>
      </a>
      <ul>
        {SECCIONES.map((s) => (
          <li>
            <a href={`${BASE}${rutaRelativa(lang, s)}`} aria-current={seccion === s ? 'page' : undefined}>
              <Icono nombre={ICONO[s]} /><span>{T.nav[s]}</span>
            </a>
          </li>
        ))}
      </ul>
      <Ajustes lang={lang} enlaceIdioma={enlaceIdioma} clase="ajustes ajustes-riel" />
    </nav>

    <div class:list={['pagina', { 'con-lateral': conLateral }]}>
      <main id="contenido" class="contenido">
        <slot />
      </main>
      {conLateral && <aside class="lateral"><slot name="lateral" /></aside>}
    </div>

    <footer class="pie">
      <span>{T.marcaLarga}</span>
      <span aria-hidden="true">·</span>
      <a href={REPO}>GitHub</a>
      <span aria-hidden="true">·</span>
      <span>{fechaCorta(compilado, lang)}</span>
    </footer>
    <script type="application/json" id="textos" set:html={jsonEnHtml(T)}></script>
    <script>
      import '../lib/cliente/base.mjs';
    </script>
  </body>
</html>
