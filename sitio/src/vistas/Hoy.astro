---
// «Hoy»: 4 bloques (micro-lección, práctica, repaso y radar). El navegador elige el día con la fecha de Chile.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { TEXTOS } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { cargarContenido, datosNavegador, jsonEnHtml } from '../lib/contenido.mjs';

const { lang, actual, alterno } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const datos = datosNavegador(await cargarContenido(), lang);
---
<Base lang={lang} titulo={T.hoy.titulo} actual={actual} alterno={alterno} seccion="hoy">
  <div class="hoy" data-hoy>
    <header class="hoy-cabeza">
      <div>
        <p class="sobretitulo" data-fecha>&nbsp;</p>
        <h1>{T.hoy.titulo}</h1>
        <p class="chip chip-acento" data-tema>&nbsp;</p>
      </div>
      <p class="estado-auto neutro" data-auto role="status">&nbsp;</p>
    </header>

    <section class="paso tarjeta" aria-labelledby="paso-titulo">
      <p class="sobretitulo" data-origen>{T.hoy.siguiente}</p>
      <h2 id="paso-titulo" class="paso-titulo">
        <a data-paso-enlace href={`${BASE}${rutaRelativa(lang, 'mapa')}`}>
          <span class="num-cap" data-paso-num></span><span data-paso-titulo></span>
        </a>
      </h2>
      <p class="paso-meta">
        <span data-modo></span>
        <a href={`${BASE}${rutaRelativa(lang, 'mapa')}`}>{T.hoy.cambiar}</a>
      </p>
      <p class="paso-nota" data-paso-nota hidden></p>
    </section>

    <div class="bloques">
      <article class="bloque tarjeta" data-bloque="leccion">
        <header class="bloque-cabeza">
          <span class="bloque-icono"><Icono nombre="leccion" /></span>
          <span class="bloque-tipo">{T.hoy.leccion}</span>
          <span class="bloque-min" data-min>5 {T.min}</span>
        </header>
        <h3 class="bloque-titulo" data-titulo></h3>
        <p class="bloque-texto" data-texto hidden></p>
        <a class="boton" data-accion hidden><span data-accion-texto></span><Icono nombre="flecha" /></a>
      </article>

      <article class="bloque tarjeta" data-bloque="practica">
        <header class="bloque-cabeza">
          <span class="bloque-icono"><Icono nombre="practica" /></span>
          <span class="bloque-tipo">{T.hoy.practica}</span>
          <span class="bloque-min" data-min>20–40 {T.min}</span>
        </header>
        <h3 class="bloque-titulo" data-titulo></h3>
        <p class="bloque-texto" data-texto hidden></p>
        <a class="boton" data-accion hidden><span data-accion-texto></span><Icono nombre="flecha" /></a>
      </article>

      <article class="bloque tarjeta" data-bloque="repaso">
        <header class="bloque-cabeza">
          <span class="bloque-icono"><Icono nombre="repaso" /></span>
          <span class="bloque-tipo">{T.hoy.repaso}</span>
          <span class="bloque-min" data-min>5 {T.min}</span>
        </header>
        <div class="repasos" data-tarjetas></div>
        <p class="bloque-texto" data-texto hidden></p>
      </article>

      <article class="bloque tarjeta bloque-vacio" data-bloque="radar">
        <header class="bloque-cabeza">
          <span class="bloque-icono"><Icono nombre="radar" /></span>
          <span class="bloque-tipo">{T.hoy.radar}</span>
          <span class="bloque-min">Top 3</span>
        </header>
        <p class="bloque-texto">{T.hoy.radarPronto}</p>
      </article>
    </div>
  </div>
  <script type="application/json" id="datos-hoy" set:html={jsonEnHtml(datos)}></script>
  <script>
    import { iniciarHoy } from '../lib/cliente/hoy-vista.mjs';
    iniciarHoy();
  </script>
</Base>
