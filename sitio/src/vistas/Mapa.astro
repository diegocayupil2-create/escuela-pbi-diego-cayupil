---
// Mapa de capítulos: niveles, requisitos y estados, y los tres modos de avanzar.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { TEXTOS, plural } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { MODOS, MODO_POR_DEFECTO, estadosCapitulos } from '../lib/ruta.mjs';
import { ICONO_ESTADO } from '../lib/iconos.mjs';
import { cargarContenido, datosNavegador, jsonEnHtml } from '../lib/contenido.mjs';

const { lang, actual, alterno } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const contenido = await cargarContenido();
const { curriculo, capitulos, porId } = contenido;
const inicial = estadosCapitulos(capitulos, { modo: MODO_POR_DEFECTO });
const ICONO_MODO = { nivelacion: 'objetivo', cero: 'escalera', libre: 'brujula' };
const LEYENDA = ['disponible', 'bloqueado', 'por-ubicar', 'dominado', 'convalidado'];
const datos = datosNavegador(contenido, lang);
---
<Base lang={lang} titulo={T.mapa.titulo} actual={actual} alterno={alterno} seccion="mapa">
  <h1>{T.mapa.titulo}</h1>
  <p class="intro">{T.mapa.intro}</p>


  <ul class="leyenda" aria-label={T.mapa.leyenda}>
    {LEYENDA.map((e) => (
      <li class="estado" data-estado={e}><Icono nombre={ICONO_ESTADO[e]} /><span>{T.estados[e]}</span></li>
    ))}
    <li class="estado estado-aqui"><Icono nombre="aqui" /><span>{T.mapa.actual}</span></li>
    <li class="estado"><span class="punto-contenido" aria-hidden="true"></span><span>{T.mapa.conContenido}</span></li>
  </ul>

  <nav class="vista-ruta tarjeta" aria-label={T.mapa.vistaRapida}>
    {curriculo.niveles.map((nivel) => (
      <div class="vr-nivel">
        <span class="vr-etiqueta" title={nivel.nombre[lang]}>{T.nivel} {nivel.id}</span>
        <ol>
          {capitulos.filter((c) => c.nivel === nivel.id).map((c) => (
            <li data-cap={c.id} data-estado={inicial.get(c.id).estado} data-titulo={`${c.num} · ${c.titulo[lang]}`} class:list={[{ 'vr-con-contenido': c.lecciones[lang].length > 0 }]}>
              <a href={`#cap-${c.id}`} aria-label={`${c.num} · ${c.titulo[lang]}`}>{c.num}</a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </nav>

  <section class="modos" aria-labelledby="modos-titulo">
    <h2 id="modos-titulo" class="h-chica">{T.mapa.modoTitulo}</h2>
    <div class="modos-opciones" role="radiogroup" aria-labelledby="modos-titulo">
      {MODOS.map((m) => (
        <label class="modo">
          <input type="radio" name="modo" value={m} checked={m === MODO_POR_DEFECTO} />
          <span class="modo-icono"><Icono nombre={ICONO_MODO[m]} /></span>
          <span class="modo-texto">
            <span class="modo-nombre">
              {T.modos[m].nombre}
              {T.modos[m].etiqueta && <span class="chip chip-acento">{T.modos[m].etiqueta}</span>}
            </span>
            <span class="modo-detalle">{T.modos[m].detalle}</span>
          </span>
        </label>
      ))}
    </div>
    <p class="nota">{T.mapa.modoGuardado}</p>
  </section>

  {curriculo.niveles.map((nivel) => {
    const lista = capitulos.filter((c) => c.nivel === nivel.id);
    return (
      <section class="nivel" aria-labelledby={`nivel-${nivel.id}`}>
        <h2 id={`nivel-${nivel.id}`} class="nivel-titulo">
          <span class="nivel-num">{T.nivel} {nivel.id}</span>
          <span>{nivel.nombre[lang]}</span>
          <span class="nivel-cuenta">{plural(lista.length, T.mapa.capitulos)}</span>
        </h2>
        <ol class="capitulos">
          {lista.map((c) => (
            <li class="cap" id={`cap-${c.id}`} data-cap={c.id} data-estado={inicial.get(c.id).estado}>
              <a class="cap-enlace" href={`${BASE}${rutaRelativa(lang, 'capitulo', { cap: c.id })}`}>
                <span class="cap-cabeza">
                  <span class="num-cap">{c.num}</span>
                  <span class="estado" data-estado-texto>
                    <Icono nombre={ICONO_ESTADO[inicial.get(c.id).estado]} />
                    <span>{T.estados[inicial.get(c.id).estado]}</span>
                  </span>
                </span>
                <span class="cap-titulo">{c.titulo[lang]}</span>
                <span class="cap-pie">
                  <span class="cap-req">
                    {c.requiere.length
                      ? `${T.mapa.requiere} ${c.requiere.map((r) => porId.get(r).num).join(', ')}`
                      : T.mapa.sinRequisitos}
                  </span>
                  <span class:list={['cap-contenido', { 'con-contenido': c.lecciones[lang].length > 0 }]}>
                    {c.lecciones[lang].length
                      ? `${plural(c.lecciones[lang].length, T.mapa.lecciones)} · ${plural(c.practicas.length, T.mapa.practicas)}`
                      : T.mapa.sinContenido}
                  </span>
                </span>
                <span class="cap-aqui"><Icono nombre="aqui" />{T.mapa.actual}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })}
  <script type="application/json" id="datos-mapa" set:html={jsonEnHtml(datos)}></script>
  <script>
    import { iniciarMapa } from '../lib/cliente/mapa-vista.mjs';
    iniciarMapa();
  </script>
</Base>
