---
// Radar: llega en la fase 4. Por ahora muestra cómo se calculará el puntaje, sin datos inventados.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { TEXTOS } from '../lib/textos.mjs';

const { lang, actual, alterno } = Astro.props;
const T = TEXTOS[lang];
// Puntaje de la propuesta (sección 8): novedad hasta 30, autoridad 30, popularidad 25 y relevancia 15.
const PARTES = [['novedad', 30], ['autoridad', 30], ['popularidad', 25], ['relevancia', 15]];
---
<Base lang={lang} titulo={T.radar.titulo} actual={actual} alterno={alterno} seccion="radar">
  <h1>{T.radar.titulo}</h1>
  <p class="intro">{T.radar.intro}</p>
  <section class="tarjeta radar-puntaje" aria-labelledby="puntaje">
    <h2 id="puntaje" class="h-chica">{T.radar.puntaje}</h2>
    <div class="barra-partes" role="img" aria-label={PARTES.map(([k, v]) => `${T.radar.partes[k]} ${v}`).join(', ')}>
      {PARTES.map(([k, v], i) => <span class={`parte parte-${i}`} style={`flex:${v}`}>{v}</span>)}
    </div>
    <ul class="partes-leyenda">
      {PARTES.map(([k, v], i) => <li><span class={`punto parte-${i}`}></span>{T.radar.partes[k]} · {v}</li>)}
    </ul>
  </section>
  <section class="tarjeta radar-ejemplo" aria-labelledby="ejemplo">
    <h2 id="ejemplo" class="h-chica">{T.radar.ejemplo}</h2>
    <p class="radar-razon"><Icono nombre="radar" /><span>{T.radar.ejemploTexto}</span></p>
  </section>
  <p class="nota">{T.radar.ritmo}</p>
</Base>
