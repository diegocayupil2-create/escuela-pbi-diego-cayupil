---
// Temario: la ruta completa como el índice de un libro. Niveles → capítulos → lecciones y prácticas,
// con requisitos, tiempo y estado; arriba, dónde vas y cuánto llevas.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { TEXTOS, plural, duracion } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { MODO_POR_DEFECTO, estadosCapitulos } from '../lib/ruta.mjs';
import { ICONO_ESTADO } from '../lib/iconos.mjs';
import { cargarContenido, datosNavegador, jsonEnHtml, tituloPractica } from '../lib/contenido.mjs';

const { lang, actual, alterno } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const contenido = await cargarContenido();
const { curriculo, capitulos, porId } = contenido;
const inicial = estadosCapitulos(capitulos, { modo: MODO_POR_DEFECTO });
const url = (tipo, ids = {}) => `${BASE}${rutaRelativa(lang, tipo, ids)}`;
const datos = datosNavegador(contenido, lang);
---
<Base lang={lang} titulo={T.temario.titulo} actual={actual} alterno={alterno} seccion="temario">
  <h1>{T.temario.titulo}</h1>
  <p class="intro">{T.temario.intro}</p>

  <section class="vas-en tarjeta" data-vas-en hidden>
    <span class="bloque-icono"><Icono nombre="aqui" /></span>
    <div class="vas-en-texto">
      <p class="sobretitulo">{T.temario.vasEn}</p>
      <p class="vas-en-cap" data-vas-cap></p>
      <p class="vas-en-item" data-vas-item></p>
    </div>
    <a class="boton" data-vas-boton>{T.temario.seguir}<Icono nombre="flecha" /></a>
  </section>
  <p class="temario-estado">
    <span data-modo></span> · <a href={url('mas')}>{T.temario.cambiar}</a> · <span data-dominados></span>
  </p>

  <ol class="libro">
    {curriculo.niveles.map((nivel) => {
      const lista = capitulos.filter((c) => c.nivel === nivel.id);
      const total = lista.reduce((s, c) => s + c.minutos, 0);
      return (
        <li class="libro-nivel">
          <h2 class="libro-nivel-titulo">
            <span class="nivel-num">{T.nivel} {nivel.id}</span>
            <span>{nivel.nombre[lang]}</span>
            <span class="nivel-cuenta">{plural(lista.length, T.temario.capitulos)} · {duracion(total, lang, true)}</span>
          </h2>
          <p class="libro-meta"><Icono nombre="objetivo" /><span><strong>{T.temario.meta}:</strong> {nivel.meta[lang]}</span></p>
          <ol class="libro-capitulos">
            {lista.map((c) => (
              <li class="libro-cap" data-cap={c.id} data-estado={inicial.get(c.id).estado}>
                <a class="libro-cap-fila" href={url('capitulo', { cap: c.id })}>
                  <span class="num-cap">{c.num}</span>
                  <span class="libro-cap-titulo">{c.titulo[lang]}</span>
                  <span class="libro-puntos" aria-hidden="true"></span>
                  <span class="libro-tiempo">{duracion(c.minutos, lang, c.estimado)}</span>
                </a>
                <p class="libro-cap-meta">
                  <span class="estado pildora" data-estado-texto>
                    <Icono nombre={ICONO_ESTADO[inicial.get(c.id).estado]} /><span>{T.estados[inicial.get(c.id).estado]}</span>
                  </span>
                  <span class="libro-aqui"><Icono nombre="aqui" />{T.temario.actual}</span>
                  <span class="pildora">{c.requiere.length ? `${T.temario.requiere} ${c.requiere.map((r) => porId.get(r).num).join(', ')}` : T.temario.sinRequisitos}</span>
                  {!c.lecciones[lang].length && <span class="pildora pildora-tenue">{T.temario.sinContenido}</span>}
                </p>
                {c.lecciones[lang].length > 0 && (
                  <ol class="libro-items">
                    {c.lecciones[lang].map((l, i) => (
                      <li data-item={l.data.id}>
                        <a href={url('leccion', { cap: c.id, id: l.data.id })}>
                          <span class="libro-item-num">{c.num}.{i + 1}</span><span>{l.data.titulo}</span>
                        </a>
                        <span class="libro-item-min">{l.data.minutos} {T.min}</span>
                        <span class="indice-marca" data-marca></span>
                      </li>
                    ))}
                    {c.practicas.map((p) => (
                      <li data-item={p.id} class="libro-item-practica">
                        <a href={url('practica', { cap: c.id, id: p.id })}>
                          <span class="libro-item-num"><Icono nombre="practica" /></span><span>{tituloPractica(p, lang, contenido.respuestas)}</span>
                        </a>
                        <span class="libro-item-min">{p.minutos} {T.min}</span>
                        <span class="indice-marca" data-marca></span>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </li>
      );
    })}
  </ol>
  <script type="application/json" id="datos-temario" set:html={jsonEnHtml(datos)}></script>
  <script>
    import { iniciarTemario } from '../lib/cliente/temario-vista.mjs';
    iniciarTemario();
  </script>
</Base>
