---
// Repaso: tarjetas que se dan vuelta, una a la vez, con ✓ me acordaba o ✕ no me acordaba.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { TEXTOS } from '../lib/textos.mjs';
import { cargarContenido, datosNavegador, jsonEnHtml } from '../lib/contenido.mjs';

const { lang, actual, alterno } = Astro.props;
const T = TEXTOS[lang];
const datos = datosNavegador(await cargarContenido(), lang);
---
<Base lang={lang} titulo={T.repaso.titulo} actual={actual} alterno={alterno} seccion="repaso">
  <div class="repaso-pagina" data-repaso>
    <h1>{T.repaso.titulo}</h1>
    <p class="intro">{T.repaso.intro}</p>

    <div class="segmentado" role="radiogroup" aria-label={T.repaso.titulo}>
      {Object.entries(T.repaso.mazos).map(([valor, nombre], i) => (
        <label><input type="radio" name="mazo" value={valor} checked={i === 0} /><span>{nombre}</span></label>
      ))}
    </div>
    <p class="nota" data-respaldo hidden>{T.repaso.sinTarjetas}</p>

    <div class="mazo" data-mazo>
      <p class="mazo-progreso" data-progreso></p>
      <span class="barra-avance" data-barra></span>
      <button type="button" class="carta" data-carta>
        <span class="carta-interior">
          <span class="carta-cara carta-frente">
            <span class="carta-tipo" data-tipo></span>
            <span class="carta-texto" data-frente></span>
            <span class="carta-ayuda"><Icono nombre="voltear" />{T.repaso.tocar}</span>
          </span>
          <span class="carta-cara carta-reverso" aria-hidden="true">
            <span class="carta-tipo">{T.repaso.respuesta}</span>
            <span class="carta-texto" data-reverso></span>
          </span>
        </span>
      </button>
      <p class="solo-lector" aria-live="polite" data-anuncio></p>
      <div class="respuestas" data-respuestas hidden>
        <button type="button" class="boton boton-no" data-no><Icono nombre="no" clase="icono sino-icono" />{T.repaso.no}</button>
        <button type="button" class="boton boton-si" data-si><Icono nombre="si" clase="icono sino-icono" />{T.repaso.si}</button>
      </div>
    </div>

    <div class="mazo-fin tarjeta" data-fin hidden>
      <h2>{T.repaso.fin}</h2>
      <p class="fin-cuentas">
        <span class="sino si"><Icono nombre="si" clase="icono sino-icono" /><span data-cuenta-si></span></span>
        <span class="sino no"><Icono nombre="no" clase="icono sino-icono" /><span data-cuenta-no></span></span>
      </p>
      <p class="fin-botones">
        <button type="button" class="boton" data-repetir>{T.repaso.repetir}</button>
        <button type="button" class="boton boton-secundario" data-otra-vez>{T.repaso.otraVez}</button>
      </p>
    </div>
    <p class="aviso-vacio" data-vacio hidden>{T.repaso.vacio}</p>
    <p class="nota">{T.repaso.nota}</p>
  </div>
  <script type="application/json" id="datos-repaso" set:html={jsonEnHtml(datos)}></script>
  <script>
    import { iniciarRepaso } from '../lib/cliente/repaso-vista.mjs';
    iniciarRepaso();
  </script>
</Base>
