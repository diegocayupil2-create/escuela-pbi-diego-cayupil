---
// Micro-lección: el texto, sus tarjetas, sus fuentes y el paso siguiente.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Fuentes from '../components/Fuentes.astro';
import Tarjetas from '../components/Tarjetas.astro';
import { TEXTOS, t } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { cargarContenido } from '../lib/contenido.mjs';

const { lang, actual, alterno, cap: idCap, id } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const contenido = await cargarContenido();
const cap = contenido.porId.get(idCap);
const lista = cap.lecciones[lang];
const i = lista.findIndex((l) => l.data.id === id);
const leccion = lista[i];
if (!leccion) throw new Error(`falta la lección ${id} en ${lang}`);
const { Content } = await render(leccion);
const tarjetas = cap.tarjetas.filter((x) => leccion.data.tarjetas.includes(x.id));
const anterior = lista[i - 1];
const siguiente = lista[i + 1];
const practica = cap.practicas[0];
const url = (tipo, extra = {}) => `${BASE}${rutaRelativa(lang, tipo, { cap: idCap, ...extra })}`;
const estado = T.estadoFuncion[leccion.data.estado];
---
<Base lang={lang} titulo={leccion.data.titulo} actual={actual} alterno={alterno} seccion="mapa">
  <a class="volver" href={url('capitulo')}><Icono nombre="atras" />{cap.num} · {cap.titulo[lang]}</a>
  <article class="lectura">
    <header>
      <p class="sobretitulo">{t(T.leccion.de, { i: i + 1, n: lista.length })}</p>
      <h1>{leccion.data.titulo}</h1>
      <p class="meta">
        <span class="chip"><Icono nombre="reloj" />{leccion.data.minutos} {T.min}</span>
        {estado && <span class="chip">{estado}{leccion.data.desde && ` · ${t(T.desde, { v: leccion.data.desde })}`}</span>}
      </p>
    </header>
    <div class="prosa">
      <Content />
    </div>
  </article>

  {tarjetas.length > 0 && (
    <section aria-labelledby="tar">
      <h2 id="tar" class="h-chica">{T.leccion.tarjetas}</h2>
      <Tarjetas tarjetas={tarjetas} lang={lang} />
    </section>
  )}

  <Fuentes fuentes={leccion.data.fuentes} lang={lang} />

  <nav class="anterior-siguiente" aria-label={cap.titulo[lang]}>
    {anterior ? <a class="boton boton-secundario" href={url('leccion', { id: anterior.data.id })}><Icono nombre="atras" />{T.leccion.anterior}</a> : <span></span>}
    {siguiente
      ? <a class="boton" href={url('leccion', { id: siguiente.data.id })}>{T.leccion.siguiente}<Icono nombre="flecha" /></a>
      : practica && <a class="boton" href={url('practica', { id: practica.id })}>{T.leccion.irPractica}<Icono nombre="flecha" /></a>}
  </nav>
</Base>
