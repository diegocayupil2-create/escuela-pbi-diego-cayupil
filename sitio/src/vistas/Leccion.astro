---
// Micro-lección: objetivo arriba, el texto con sus diagramas, «Para recordar» al final y el índice del capítulo a mano.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Fuentes from '../components/Fuentes.astro';
import Tarjetas from '../components/Tarjetas.astro';
import IndiceCapitulo from '../components/IndiceCapitulo.astro';
import AnteriorSiguiente from '../components/AnteriorSiguiente.astro';
import { TEXTOS, t } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { cargarContenido, htmlLeccion, vecinos } from '../lib/contenido.mjs';

const { lang, actual, alterno, cap: idCap, id } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const contenido = await cargarContenido();
const cap = contenido.porId.get(idCap);
const lista = cap.lecciones[lang];
const i = lista.findIndex((l) => l.data.id === id);
const leccion = lista[i];
if (!leccion) throw new Error(`falta la lección ${id} en ${lang}`);
const tarjetas = cap.tarjetas.filter((x) => leccion.data.tarjetas.includes(x.id));
const estado = T.estadoFuncion[leccion.data.estado];
const { anterior, siguiente } = vecinos(contenido, 'leccion', idCap, id, lang);
const deCuantas = t(T.leccion.de, { i: i + 1, n: lista.length });
---
<Base lang={lang} titulo={leccion.data.titulo} actual={actual} alterno={alterno} seccion="temario">
  <IndiceCapitulo slot="lateral" cap={cap} lang={lang} contenido={contenido} actualId={id} variante="lateral" />
  <a class="volver" href={`${BASE}${rutaRelativa(lang, 'capitulo', { cap: idCap })}`}><Icono nombre="atras" />{cap.num} · {cap.titulo[lang]}</a>
  <IndiceCapitulo cap={cap} lang={lang} contenido={contenido} actualId={id} variante="plegable" resumen={deCuantas} />

  <article class="lectura">
    <header>
      <p class="sobretitulo">{deCuantas}</p>
      <h1>{leccion.data.titulo}</h1>
      <p class="meta">
        <span class="chip"><Icono nombre="reloj" />{leccion.data.minutos} {T.min}</span>
        {estado && <span class="chip">{estado}{leccion.data.desde && ` · ${t(T.desde, { v: leccion.data.desde })}`}</span>}
      </p>
    </header>
    <p class="objetivo"><Icono nombre="objetivo" /><span><strong>{T.leccion.objetivo}:</strong> {leccion.data.objetivo}</span></p>
    <div class="prosa" set:html={htmlLeccion(leccion)} />

    <aside class="recordar" aria-labelledby="recordar">
      <h2 id="recordar" class="recordar-titulo"><Icono nombre="recordar" />{T.leccion.recordar}</h2>
      <ul>{leccion.data.recordar.map((r) => <li>{r}</li>)}</ul>
      <button type="button" class="boton boton-marcar" data-marcar={id} aria-pressed="false" data-texto-marcar={T.leccion.marcar} data-texto-hecho={T.leccion.marcada}>
        <Icono nombre="si" clase="icono sino-icono" /><span data-marcar-texto>{T.leccion.marcar}</span>
      </button>
    </aside>
  </article>

  {tarjetas.length > 0 && (
    <section aria-labelledby="tar">
      <h2 id="tar" class="h-chica">{T.leccion.tarjetas}</h2>
      <Tarjetas tarjetas={tarjetas} lang={lang} />
    </section>
  )}

  <Fuentes fuentes={leccion.data.fuentes} lang={lang} />
  <AnteriorSiguiente anterior={anterior} siguiente={siguiente} lang={lang} />
  <script>
    import { iniciarIndices } from '../lib/cliente/indice-vista.mjs';
    iniciarIndices();
  </script>
</Base>
