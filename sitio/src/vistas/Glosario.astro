---
// Glosario: los términos de todos los capítulos, agrupados por capítulo, con dónde aparecen.
import Base from '../layouts/Base.astro';
import { TEXTOS, t } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { cargarContenido } from '../lib/contenido.mjs';

const { lang, actual, alterno } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const { capitulos } = await cargarContenido();
const conGlosario = capitulos.filter((c) => c.glosario.length);
const titulo = (cap, id) => cap.lecciones[lang].find((l) => l.data.id === id)?.data.titulo ?? id;
---
<Base lang={lang} titulo={T.glosario.titulo} actual={actual} alterno={alterno} seccion="mas">
  <h1>{T.glosario.titulo}</h1>
  <p class="intro">{T.glosario.intro}</p>
  {conGlosario.map((cap) => (
    <section class="glosario-cap" id={cap.id} aria-labelledby={`g-${cap.id}`}>
      <h2 id={`g-${cap.id}`} class="h-chica">
        <a href={`${BASE}${rutaRelativa(lang, 'capitulo', { cap: cap.id })}`}>{t(T.glosario.capitulo, { n: cap.num })} · {cap.titulo[lang]}</a>
      </h2>
      <dl class="glosario">
        {[...cap.glosario].sort((a, b) => a.termino.localeCompare(b.termino, lang)).map((g) => (
          <div class="glosario-item">
            <dt><span class="glosario-termino">{g.termino}</span>{g.traduccion && lang === 'es' && <span class="glosario-traduccion">{g.traduccion}</span>}</dt>
            <dd>
              {g.definicion[lang]}
              {g.lecciones && (
                <span class="glosario-ver">{T.glosario.ver}: {g.lecciones.map((id, i) => (
                  <>{i > 0 && ' · '}<a href={`${BASE}${rutaRelativa(lang, 'leccion', { cap: cap.id, id })}`}>{titulo(cap, id)}</a></>
                ))}</span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
</Base>
