---
// Capítulo: su índice con «vas aquí» arriba; después qué vas a poder hacer, cómo se domina, requisitos y fuentes.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Fuentes from '../components/Fuentes.astro';
import IndiceCapitulo from '../components/IndiceCapitulo.astro';
import AnteriorSiguiente from '../components/AnteriorSiguiente.astro';
import { TEXTOS, t, duracion } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
import { cargarContenido, datosNavegador, jsonEnHtml, vecinos } from '../lib/contenido.mjs';

const { lang, actual, alterno, cap: id } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const contenido = await cargarContenido();
const cap = contenido.porId.get(id);
const nivel = contenido.curriculo.niveles.find((n) => n.id === cap.nivel);
const { practicas_min, puntaje_min, repasos_min } = contenido.curriculo.dominio;
const estadoFuncion = T.estadoFuncion[cap.estado];
const { capitulos, textos } = datosNavegador(contenido, lang);
const datos = { id, capitulos: capitulos.map(({ id, nivel, requiere }) => ({ id, nivel, requiere })), textos };
const { anterior, siguiente } = vecinos(contenido, 'capitulo', id, null, lang);
const segmentos = (n) => Array.from({ length: n }, () => '');
---
<Base lang={lang} titulo={`${cap.num} · ${cap.titulo[lang]}`} descripcion={cap.resumen[lang]} actual={actual} alterno={alterno} seccion="temario">
  <a class="volver" href={`${BASE}${rutaRelativa(lang, 'temario')}`}><Icono nombre="atras" />{T.volverTemario}</a>
  <header class="cabeza-capitulo">
    <span class="num-cap num-grande">{cap.num}</span>
    <div>
      <p class="sobretitulo">{T.nivel} {cap.nivel} · {nivel.nombre[lang]} · {duracion(cap.minutos, lang, cap.estimado)}</p>
      <h1>{cap.titulo[lang]}</h1>
    </div>
  </header>
  <p class="intro">{cap.resumen[lang]}</p>
  <div class="fila-estado">
    <span class="estado" data-estado-texto></span>
    {estadoFuncion && <span class="chip">{estadoFuncion}</span>}
    <button type="button" class="boton boton-secundario boton-chico" data-elegir><Icono nombre="aqui" /><span>{T.capituloPagina.elegir}</span></button>
  </div>
  <p class="nota" data-no-disponible hidden>
    {T.capituloPagina.noDisponible} <a href={`${BASE}${rutaRelativa(lang, 'mas')}`}>{T.hoy.cambiar}</a>
  </p>
  {cap.nota_estado && <p class="nota">{cap.nota_estado[lang]}</p>}

  {cap.lecciones[lang].length || cap.practicas.length
    ? <IndiceCapitulo cap={cap} lang={lang} contenido={contenido} variante="principal" />
    : <p class="aviso-vacio">{T.capituloPagina.sinContenido}</p>}

  {cap.competencias.length > 0 && (
    <section class="logros" aria-labelledby="logros">
      <h2 id="logros" class="h-chica">{T.capituloPagina.competencias}</h2>
      <ul class="lista-logros">{cap.competencias.map((k) => <li><Icono nombre="objetivo" /><span>{k[lang]}</span></li>)}</ul>
    </section>
  )}

  {cap.id !== 'c00' && (
    <section class="dominio tarjeta" aria-labelledby="dominio">
      <h2 id="dominio" class="h-chica">{T.capituloPagina.dominio}</h2>
      <div class="dominio-fila">
        <span>{t(T.capituloPagina.dominioPracticas, { p: puntaje_min })}</span>
        <span class="segmentos" role="img" aria-label={`0 / ${practicas_min}`}>{segmentos(practicas_min).map(() => <i></i>)}</span>
        <span class="dominio-cuenta">0 / {practicas_min}</span>
      </div>
      <div class="dominio-fila">
        <span>{T.capituloPagina.dominioRepasos}</span>
        <span class="segmentos" role="img" aria-label={`0 / ${repasos_min}`}>{segmentos(repasos_min).map(() => <i></i>)}</span>
        <span class="dominio-cuenta">0 / {repasos_min}</span>
      </div>
      <p class="nota">{T.capituloPagina.dominioNota}</p>
    </section>
  )}

  {cap.requiere.length > 0 && (
    <section aria-labelledby="req">
      <h2 id="req" class="h-chica">{T.capituloPagina.requisitos}</h2>
      <ul class="chips">
        {cap.requiere.map((r) => {
          const req = contenido.porId.get(r);
          return <li><a class="chip chip-enlace" href={`${BASE}${rutaRelativa(lang, 'capitulo', { cap: r })}`}>{req.num} · {req.titulo[lang]}</a></li>;
        })}
      </ul>
    </section>
  )}

  <Fuentes fuentes={cap.fuentes} lang={lang} titulo={T.capituloPagina.fuentes} />
  <AnteriorSiguiente anterior={anterior} siguiente={siguiente} lang={lang} />

  <script type="application/json" id="datos-capitulo" set:html={jsonEnHtml(datos)}></script>
  <script>
    import { iniciarCapitulo } from '../lib/cliente/capitulo-vista.mjs';
    import { iniciarIndices } from '../lib/cliente/indice-vista.mjs';
    iniciarCapitulo();
    iniciarIndices();
  </script>
</Base>
