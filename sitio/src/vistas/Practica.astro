---
// Práctica en Power BI: el caso, los pasos, cómo saber si está bien, pistas y la solución oculta hasta que la pidas.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Fuentes from '../components/Fuentes.astro';
import SiNo from '../components/SiNo.astro';
import { TEXTOS, t } from '../lib/textos.mjs';
import { REPO, rutaRelativa } from '../lib/enlaces.mjs';
import { cargarContenido, practicaVista } from '../lib/contenido.mjs';

const { lang, actual, alterno, cap: idCap, id } = Astro.props;
const T = TEXTOS[lang];
const BASE = import.meta.env.BASE_URL;
const contenido = await cargarContenido();
const cap = contenido.porId.get(idCap);
const p = cap.practicas.find((x) => x.id === id);
const v = await practicaVista(p, lang, contenido.respuestas);
const datasetNombre = p.dataset.split('/').at(-1);
const rutaPc = p.dataset.replaceAll('/', '\\');
---
<Base lang={lang} titulo={v.titulo} actual={actual} alterno={alterno} seccion="mapa">
  <a class="volver" href={`${BASE}${rutaRelativa(lang, 'capitulo', { cap: idCap })}`}><Icono nombre="atras" />{cap.num} · {cap.titulo[lang]}</a>
  <article class="lectura">
    <header>
      <p class="sobretitulo">{T.hoy.practica} · {T.practica.tipos[p.tipo_pregunta]}</p>
      <h1>{v.titulo}</h1>
      <p class="meta"><span class="chip"><Icono nombre="reloj" />{p.minutos} {T.min}</span></p>
    </header>

    <section aria-labelledby="obj">
      <h2 id="obj" class="h-chica">{T.practica.objetivo}</h2>
      <div class="prosa" set:html={v.objetivo} />
    </section>
    <section aria-labelledby="pq">
      <h2 id="pq" class="h-chica">{T.practica.porQue}</h2>
      <div class="prosa" set:html={v.porQue} />
    </section>
    <section aria-labelledby="ctx">
      <h2 id="ctx" class="h-chica">{T.practica.contexto}</h2>
      <div class="prosa" set:html={v.contexto} />
    </section>

    <aside class="dataset tarjeta" aria-label={T.practica.dataset}>
      <span class="bloque-icono"><Icono nombre="dataset" /></span>
      <div>
        <p class="dataset-nombre">{T.practica.dataset}: <strong>{datasetNombre}</strong></p>
        <p class="nota">{T.practica.datasetLocal} <code>{rutaPc}</code></p>
        <a href={`${REPO}/tree/main/${p.dataset}`} rel="noopener">{T.practica.verDataset}</a>
      </div>
    </aside>

    <section aria-labelledby="pas">
      <h2 id="pas" class="h-chica">{T.practica.pasos}</h2>
      <ol class="pasos">{v.pasos.map((x) => <li set:html={x} />)}</ol>
    </section>

    <section aria-labelledby="cri">
      <h2 id="cri" class="h-chica">{T.practica.criterios}</h2>
      <ul class="criterios">
        {v.criterios.map((x) => (
          <li><SiNo valor={true}><Fragment set:html={x} /></SiNo></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="pis">
      <h2 id="pis" class="h-chica">{T.practica.pistas}</h2>
      <div class="pistas">
        {v.pistas.map((x, i) => (
          <details class="pista">
            <summary>{t(T.practica.pista, { i: i + 1 })}</summary>
            <p set:html={x} />
          </details>
        ))}
      </div>
    </section>

    <details class="solucion">
      <summary><Icono nombre="si" />{T.practica.solucion}</summary>
      <p class="nota">{T.practica.solucionAviso}</p>
      <div class="prosa" set:html={v.solucion} />
      <h3 class="h-chica">{T.practica.storytelling}</h3>
      <div class="prosa" set:html={v.storytelling} />
    </details>

    <p class="nota entregar" set:html={t(T.practica.entregar, { ruta: `<code>trabajos\\${p.id}\\</code>`, comando: `<code>/entregar ${p.id}</code>` })} />
  </article>
  <Fuentes fuentes={p.fuentes} lang={lang} />
</Base>
