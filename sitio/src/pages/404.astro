---
// Página que muestra GitHub Pages cuando un link no existe.
import Base from '../layouts/Base.astro';
import { TEXTOS } from '../lib/textos.mjs';
import { rutaRelativa } from '../lib/enlaces.mjs';
const BASE = import.meta.env.BASE_URL;
const T = TEXTOS.es;
---
<Base lang="es" titulo={T.noEncontrada.titulo} actual={rutaRelativa('es', 'hoy')} alterno={rutaRelativa('en', 'hoy')}>
  <h1>{T.noEncontrada.titulo}</h1>
  <p lang="en">{TEXTOS.en.noEncontrada.titulo}.</p>
  <p>
    <a class="boton" href={`${BASE}${rutaRelativa('es', 'hoy')}`}>{T.noEncontrada.volver}</a>
    <a class="boton boton-secundario" href={`${BASE}${rutaRelativa('en', 'hoy')}`} lang="en">{TEXTOS.en.noEncontrada.volver}</a>
  </p>
</Base>
