---
// Inicio de la app instalada: abre «Hoy» en el último idioma que usaste (español la primera vez).
const BASE = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Escuela PBI Diego Cayupil</title>
    <link rel="manifest" href={`${BASE}manifest.webmanifest`} />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <script is:inline define:vars={{ BASE }}>
      var idioma = 'es';
      try {
        if (localStorage.getItem('escuela.idioma') === 'en') idioma = 'en';
      } catch (e) {}
      location.replace(BASE + idioma + '/');
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${BASE}es/`} /></noscript>
  </head>
  <body>
    <p><a href={`${BASE}es/`}>Escuela PBI · Hoy</a> · <a href={`${BASE}en/`} lang="en">PBI School · Today</a></p>
  </body>
</html>
